def check_parentheses(expression):
    stack = []
    for char in expression:
        if char == '(':
            stack.append(char)
        elif char == ')':
            if not stack:
                return False
            stack.pop()
    return len(stack) == 0
expression = input("Enter expression: ")
if check_parentheses(expression):
    print("Parentheses are balanced")
else:
    print("Parentheses are not balanced")

